{
  "name": "kindle-stats-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:public": "bun run build && bun run scripts/preparePublicBuild.ts",
    "deploy": "bun run build:public && wrangler deploy",
    "preview": "vite preview",
    "extract": "bun run scripts/extractKindleData.ts",
    "metrics": "bun run scripts/buildDerivedMetrics.ts",
    "goodreads-asins": "bun run scripts/fetchGoodreadsAsinTitles.ts",
    "metrics:with-goodreads": "bun run goodreads-asins && bun run metrics",
    "ingest": "bun run extract && bun run metrics",
    "snapshot": "bun run scripts/createSnapshot.ts",
    "sync": "bun run ingest",
    "test": "bun test"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "csv-parse": "^5.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "bun-types": "^1.3.11",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  }
}
